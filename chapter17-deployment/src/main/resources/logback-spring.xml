<!--
  Spring Boot Logback Configuration for Production Environment

  Features:
  - Structured JSON logging for production
  - Log rotation with size and time based policies
  - Separate log files for different concerns
  - Sensitive data masking
  - Performance optimized
-->
<configuration>
    <!-- Properties from Spring Boot -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="chapter17-deployment"/>
    <property name="LOG_PATH" value="${LOG_PATH:-/app/logs}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Colors for console output -->
    <springProfile name="!prod">
        <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){magenta} %clr(%-5level){highlight} %clr(%logger{36}){cyan} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- Production Console (structured logging) -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- File Appender with Rotation -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Error Log Appender -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- AgentScope Specific Log -->
    <appender name="AGENT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/agentscope.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/agentscope.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Async Appender for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <appender name="ASYNC_AGENT" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <appender-ref ref="AGENT_FILE"/>
    </appender>

    <!-- Logger Configurations -->

    <!-- AgentScope Logger -->
    <logger name="io.agentscope" level="DEBUG" additivity="true">
        <appender-ref ref="ASYNC_AGENT"/>
    </logger>

    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO" additivity="true"/>
    <logger name="org.springframework.web" level="INFO" additivity="true"/>
    <logger name="org.springframework.boot" level="INFO" additivity="true"/>

    <!-- Tomcat/Jetty -->
    <logger name="org.apache.catalina" level="WARN" additivity="true"/>
    <logger name="org.apache.tomcat" level="WARN" additivity="true"/>
    <logger name="org.eclipse.jetty" level="WARN" additivity="true"/>

    <!-- HikariCP (connection pool) -->
    <logger name="com.zaxxer.hikari" level="INFO" additivity="true"/>
    <logger name="com.zaxxer.hikari.pool" level="DEBUG" additivity="true"/>

    <!-- MySQL -->
    <logger name="com.mysql" level="WARN" additivity="true"/>

    <!-- Redis -->
    <logger name="io.lettuce" level="INFO" additivity="true"/>
    <logger name="org.springframework.data.redis" level="DEBUG" additivity="true"/>

    <!-- Hibernate/JPA -->
    <logger name="org.hibernate" level="WARN" additivity="true"/>
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="true"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="true"/>

    <!-- Micrometer -->
    <logger name="io.micrometer" level="INFO" additivity="true"/>

    <!-- OpenTelemetry -->
    <logger name="io.opentelemetry" level="INFO" additivity="true"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </root>

    <!-- Production Profile - More aggressive optimizations -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
    </springProfile>

    <!-- Development Profile - More verbose -->
    <springProfile name="dev,development">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="io.agentscope" level="TRACE" additivity="true"/>
    </springProfile>

    <!-- Test Profile -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>