    .baseUrl(&quot;http://localhost:11434&quot;)  // Ollama 服务地址
    .modelName(&quot;nomic-embed-text&quot;)       // 模型名称
    .dimensions(768)                     // 向量维度
    .timeout(Duration.ofSeconds(30))     // 超时时间
    .build();
