                .role(MsgRole.USER)
                .content(TextBlock.builder().text(&quot;计算 12345 * 67890&quot;).build())
                .build();

        logger.info(&quot;发送计算请求...&quot;);
        processRequest(routerAgent, calcRequest);
    }

    /**
     * 示例 2：并行查询模式
     *
     * &lt;p&gt;同时查询多个代理，汇总结果。
     */
    public void parallelQueryDemo() {
