        // 创建多个代理实例
        A2aAgent agent1 = ClientRunner.createHttpAgent(
            &quot;http://localhost:8081&quot;,
            &quot;query-agent-1&quot;
        );
        A2aAgent agent2 = ClientRunner.createHttpAgent(
            &quot;http://localhost:8082&quot;,
            &quot;query-agent-2&quot;
        );

        // 构建查询请求
