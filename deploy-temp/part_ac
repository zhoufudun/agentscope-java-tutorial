     */
    @GetMapping
    public ResponseEntity&lt;Map&lt;String, String&gt;&gt; index() {
        return ResponseEntity.ok(Map.of(
                &quot;service&quot;, &quot;AgentScope Harness - 第十五章：安全执行环境&quot;,
                &quot;endpoints&quot;,
                &quot;POST /api/execute, POST /api/execute/agent, DELETE /api/workspace, GET /api/status&quot;
        ));
    }
}
