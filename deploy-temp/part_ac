 * 因此此类仅作为数据传输对象（DTO）。
 *
 * @see io.agentscope.tutorial.chapter16.repository.SessionRepository
 */
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class SessionMessage {

