            boolean success = scheduleService.deleteSchedule(scheduleId);
            return success ? &quot;日程已删除&quot; : &quot;删除失败，日程可能不存在&quot;;
        } catch (Exception e) {
            return &quot;删除日程失败：&quot; + e.getMessage();
        }
    }
}
