    public ToolResult generateChart(Map&lt;String, Object&gt; params) {
        try {
            String result = reportAgent.generateChart(params);
            return ToolResult.success(&quot;图表生成完成&quot;, result);
        } catch (Exception e) {
            return ToolResult.failure(&quot;生成图表失败：&quot; + e.getMessage());
        }
    }
}
