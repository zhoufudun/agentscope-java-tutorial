public class WeatherTools {

    private static final Random RANDOM = new Random();
    private static final DateTimeFormatter DATE_FORMAT =
        DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd HH:mm:ss&quot;);

    /**
     * 获取指定城市的当前天气
     *
